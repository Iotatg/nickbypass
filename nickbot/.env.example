# ---------------------------------------------------------------
# 复制成 .env 再填。不要把真实 token 提交到任何仓库。
# 如果 token 曾经发到公开聊天 / 群 / 截图里，立刻去 @BotFather /revoke。
# ---------------------------------------------------------------

# 从 @BotFather 拿
BOT_TOKEN=

# 你的 Telegram 数字 ID（多个用逗号分隔），用 /id 命令可以查
OWNER_ID=

# 可选：异常日志转发到这个 chat（群 ID 是负数，例如 -100xxxxxxxxxx）
LOGGER_CHAT_ID=

# 以下一般不用动
RATE_LIMIT=6
RATE_WINDOW=60
MAX_URLS=5
HTTP_TIMEOUT=20
BROWSER_TIMEOUT=30
ALLOW_BROWSER=true
HTTP_CONCURRENCY=4
BROWSER_CONCURRENCY=1

# 可选：给解析引擎走代理（http://user:pass@host:port）
# 这是 IP 墙站点（vplink 等）唯一稳定解法：住宅 / 移动 IP
PROXY=

# 可选：按国家自动维护出口 IP 池（免费源，时好时坏，但不要钱）
PROXY_FARM=false
PROXY_COUNTRY=IN
PROXY_BUDGET=12

# 解析引擎位置（默认 ../linkresolver）
# LINKRESOLVER_HOME=/opt/linkresolver
