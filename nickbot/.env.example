# ---------------------------------------------------------------
# Copy to .env and fill it in. Never commit a real token.
# If a token ever appeared in a public chat, screenshot or repo,
# revoke it with @BotFather /revoke before doing anything else.
# ---------------------------------------------------------------

# From @BotFather
BOT_TOKEN=

# ---------------------------------------------------------------
# Backend: kurigram | ptb | auto   (default auto)
#   auto     -> Kurigram when API_ID/API_HASH are filled in, else PTB
#   kurigram -> MTProto, faster, no Bot API polling limits
#   ptb      -> python-telegram-bot, token only
# Kurigram needs an app pair from https://my.telegram.org -> API development
# tools. Log in with your own account, create an app, copy the two values.
# ---------------------------------------------------------------
BACKEND=auto
API_ID=
API_HASH=

# Your numeric Telegram ID (comma-separated for several). /id shows it.
OWNER_ID=

# Optional: forward errors to this chat (group IDs are negative, -100…)
LOGGER_CHAT_ID=

# Usually leave these alone
RATE_LIMIT=6
RATE_WINDOW=60
MAX_URLS=5
HTTP_TIMEOUT=20
BROWSER_TIMEOUT=30
ALLOW_BROWSER=true
HTTP_CONCURRENCY=4
BROWSER_CONCURRENCY=1

# Optional: send the resolver through a proxy (http://user:pass@host:port)
# The only reliable fix for IP-walled sites (vplink and friends): a
# residential or mobile exit.
PROXY=

# Optional: keep a pool of exit IPs per country (free sources — hit and miss,
# but free). Only used when a site walls our IP.
PROXY_FARM=false
PROXY_COUNTRY=IN
PROXY_BUDGET=12

# Resolver engine location (defaults to ../linkresolver)
# LINKRESOLVER_HOME=/opt/linkresolver
